# ============================================================
# Environment: DEV. IDENTITY ONLY.
# Copy to terraform.tfvars (git-ignored). Controls, flags and cost settings are NOT set here:
# they live in environments/common.tfvars so dev, test and prod behave identically.
# ============================================================

organization_name = "acme-enterprise"
environment       = "dev"
owner       = "Platform Engineering"
cost_center       = "LAB001"

# Account root emails — must be unique globally
security_account_email        = "security-dev@example.com"
logging_account_email         = "logging-dev@example.com"
shared_services_account_email = "shared-dev@example.com"
development_account_email     = "dev@example.com"
production_account_email      = "prod@example.com"

# Fill in after the accounts exist (first apply creates them; or pass existing IDs).
management_account_id = ""
security_account_id   = ""
logging_account_id    = ""

# Distinct, non-overlapping ranges per environment so VPCs can be peered later.
af-south-1 = {
  vpc_cidr = "your-cidr-range"
 
  private_subnet_cidrs = [
  "your-subnet-cidr-range/24",
  "your-subnet-cidr-range/24"
]

public_subnet_cidrs = [
  "your-subnet-cidr-range/24",
  "your-subnet-cidr-range/24"
]

intra_subnet_cidrs = [
  "your-subnet-cidr-range/24",
  "your-subnet-cidr-range/24"
]
}

eu-west-1 = {
  vpc_cidr = "your-cidr-range"
 
  private_subnet_cidrs = [
  "your-subnet-cidr-range/24",
  "your-subnet-cidr-range/24"
]

public_subnet_cidrs = [
  "your-subnet-cidr-range/24",
  "your-subnet-cidr-range/24"
]

intra_subnet_cidrs = [
  "your-subnet-cidr-range/24",
  "your-subnet-cidr-range/24"
]
}

# Per-environment allowed difference: the budget ceiling.
monthly_budget_usd = 20
budget_alert_email = "cloudteam@example.com"
alert_email        = "cloudteam@example.com"

# Existing public hosted zone (leave "" to skip DNS/ACM).
route53_domain_name = ""